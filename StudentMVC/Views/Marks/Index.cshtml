@model IEnumerable<StudentMVC.Models.Mark>

@{
    ViewData["Title"] = "Index";

    Pager pager = new Pager();
    int pageNo = 0;
    if(ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Marks Table</h2>
        </div>
        <div class="col-6 text-end">
            <p>
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> &nbsp; Create New</a>
            </p>
        </div>
    </div>
    </div>
<table class="table table-bordered table-striped box-shadow" style="width:100%">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Marks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Class.ClassName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student.StudentName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td >
                @Html.DisplayFor(modelItem => item.Marks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Class.ClassName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Student.StudentName)
            </td>
                <td width="30%">
                    <a asp-action="Edit" asp-route-id="@item.MarksId" class="btn btn-primary"><i class="bi bi-pencil-square"></i> &nbsp;Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.MarksId" class="btn btn-primary"><i class="bi bi-file-earmark-person"></i> &nbsp;Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.MarksId" class="btn btn-primary"><i class="bi bi-trash3"></i> &nbsp; Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<div class="container">
    @if(pager.TotalPages > 0)
    {
        <ul class="pagination justify-content-end">
            @for(var pge = pager.StartPage; pge <= pager.EndPage; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a asp-action="Index" asp-route-pg="@pge" class="page-link"> @pge </a>
                </li>
            }
@*
            @if(pager.CurrentPage < pager.TotalPages)
            {
                <li class="page-item">
                    <a asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)" class="page-link">Next </a>
                </li>
                <li class="page-item">
                    <a asp-action="Index" asp-route-pg="@(pager.TotalPages)" class="page-link">Last</a>
                </li>
            }*@
        @*    @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a asp-action="Index" asp-route-pg="1" class="page-link">FIrst</a>
                </li>
                <li class="page-item">
                    <a asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)" class="page-link">Previous</a>
                </li>
            }*@
        </ul>
    }
</div>
