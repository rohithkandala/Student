@model IEnumerable<StudentMVC.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Student List</h2>
        </div>
        <div class="col-6 text-end">
            <p>
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> &nbsp;Create New</a>
            </p>
        </div>
    </div>



    <table class="table table-bordered table-striped box-shadow" style="width:100%">
    <thead>
        <tr>
             <th>
                    @Html.DisplayNameFor(model => model.StudentName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td width="50%">
                @Html.DisplayFor(modelItem => item.StudentName)
            </td>
            <td width="20%">
                        <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-primary"><i class="bi bi-pencil-square"></i> &nbsp;Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-primary"><i class="bi bi-file-earmark-person"></i> &nbsp; Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-primary"><i class="bi bi-trash3"></i> &nbsp; Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>