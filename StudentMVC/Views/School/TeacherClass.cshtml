@model IEnumerable<StudentMVC.Models.TeacherClass>

@{
    ViewData["Title"] = "TeacherClass";
    ViewBag.IsFirstTime = true;
}

<!DOCTYPE html>
<html>
<head>
    <title>TeacherCLass</title>
</head>
<body>


    <div class="container p-3">
        <div class="row pt-4">
            <div class="col-4">
                <h2 class="text-primary">Give Teacher Name </h2>
            </div>
        </div>
    </div>


    <div class="col-md-4">
    <form action="TeacherClass" method="post">
            <div class="form-group p-1 mt-2">
                <label for="TeacherName" class="control-label mb-3"><h5>TeacherName:</h5></label>
            <input type="text" id="TeacherName" name="TeacherName" class="form-control"/>
        </div>
            <div class="form-group p-1 mt-2">
            <button type="submit" value="TeacherClass" class="btn btn-secondary" style="width:150px">Submit</button>
            </div>
    </form>
</div>

@if (Model.Any())
{
        @foreach(var item in Model)
        {
            if (item == Model.First())
            {
                <p style="margin-top: 50px;"><h5>Teacher Name: @Html.DisplayFor(modelItem => item.TeacherName)</h5></p>
                break;
            }
        }

        <h1>TeacherClass</h1>
        
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ClassName)
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.ClassName)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        @if(ViewBag.IsFirstTime)
        {
        }
        else
        {
            <p><h5>TeacherName not available.</h5></p>
        }
    }
</body>
</html>