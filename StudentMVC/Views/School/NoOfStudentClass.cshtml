@model NoOfStudentClass

<!DOCTYPE html>
<html>
<head>
    <title>NoOfStudentClass</title>
</head>
<body>

    <div class="container p-3">
        <div class="row pt-4">
            <div class="col-4">
                <h2 class="text-primary">CLass Name </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
    <form action="NoOfStudentClass" method="post">
            <div class="form-group p-1 mt-2">
                <label for="ClassName" class="control-label mb-3"><h5>Class Name:</h5></label>
                <input type="text" id="ClassName" name="ClassName" class="form-control" />
        </div>
            <div class="form-group p-1 mt-2">
                <button type="submit" value="NoOfStudentClass" class="btn btn-secondary" style="width:150px">Submit</button>
            </div>
    </form>
    </div>


    <h3>NoOfStudentClass</h3>
    @if (Model != null)
    {
        <p>NoOfStudentsInClass: @Model.NoOfStudentsInClass</p>
    }
    else
    {
        <p>NoOfStudentsInClass not available.</p>
    }
</body>
</html>















